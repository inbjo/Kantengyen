# Set this to your real domain before deploying. Caddy will request a TLS certificate.
SITE_ADDRESS=play.example.com

# Binary deployment defaults to data/state.json; systemd uses /var/lib/kantengyen/state.json.
# Compose sets /data/state.json with a persistent game_data volume.
# The state file includes private hands and session credentials; keep it private.

# Docker public deployment: embedded IPv4 TURN (UDP/TCP, optional TLS) runs inside the game server.
TURN_ENABLED=true
# Required when enabled: your real public IPv4, not the container/host private IP.
TURN_PUBLIC_IP=
# Optional DNS A record pointing to TURN_PUBLIC_IP; defaults to the public IP.
TURN_PUBLIC_HOST=
TURN_TCP_ENABLED=true
# Advertise all enabled transports, or force udp/tcp/tls for verification.
TURN_TRANSPORT=all
TURN_MAX_CONNECTIONS=128
TURN_MAX_ALLOCATIONS=64
# Per allocation, per direction, bytes/second.
TURN_BYTES_PER_SECOND=128000

# Extra ICE servers / external TURN remain optional. Built-in servers are advertised automatically.
VOICE_ICE_SERVERS=[]
VOICE_ICE_POLICY=all
VOICE_TURN_URLS=
VOICE_TURN_SECRET=
# Example (use your own domain and a long random shared secret):
# VOICE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# With embedded TURN, an empty secret generates a new random secret at each startup.
# To keep it stable, set at least 32 random characters; never commit real secrets.
# VOICE_TURN_SECRET=replace-with-a-long-random-secret
