[Unit]
Description=Kantengyen game server
After=network.target

[Service]
Type=simple
User=kantengyen
Group=kantengyen
WorkingDirectory=/opt/kantengyen
Environment=BIND_ADDR=127.0.0.1:3000
Environment=RUST_LOG=kantengyen_server=info
EnvironmentFile=-/etc/kantengyen.env
ExecStart=/opt/kantengyen/kantengyen-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
